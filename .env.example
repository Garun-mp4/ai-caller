APP_ENV=development
HOST_BIND_ADDRESS=127.0.0.1
APP_NAME=AI Call Agent
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./ai_caller.db
JWT_SECRET=local-development-secret-change-me

AUTH_MODE=local
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=admin
OPENAI_OAUTH_CLIENT_ID=
OPENAI_OAUTH_CLIENT_SECRET=
OPENAI_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/chatgpt/callback

STT_PROVIDER=vosk
VOSK_MODEL_PATH=../models/vosk/model

TTS_PROVIDER=piper
PIPER_BINARY=piper
PIPER_MODEL_PATH=../models/piper/voice.onnx
PIPER_CONFIG_PATH=../models/piper/voice.onnx.json

LLM_PROVIDER=mock
CODEX_BINARY=codex
CODEX_MODEL=
CODEX_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=20

TELEPHONY_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

MAX_CONCURRENT_CALLS=1
MAX_UPLOAD_BYTES=1048576
CALLING_HOURS_START=09:00
CALLING_HOURS_END=18:00
APP_TIMEZONE=Europe/Helsinki
MAX_ATTEMPTS=3
RETRY_DELAY_MINUTES=60
